{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "None",
    "moduleResolution": "node",
    "types": ["google-apps-script"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
